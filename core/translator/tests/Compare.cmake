execute_process(COMMAND ${NATIVE} OUTPUT_VARIABLE nativeOutput RESULT_VARIABLE nativeResult)
execute_process(COMMAND ${TRANSLATED} ${ELF} OUTPUT_VARIABLE translatedOutput ERROR_VARIABLE translatedError
    RESULT_VARIABLE translatedResult)
message("${translatedOutput}")
if(NOT nativeResult EQUAL 0)
    message(FATAL_ERROR "Native reference failed with ${nativeResult}")
endif()
if(NOT translatedResult EQUAL 0)
    message(FATAL_ERROR "Translated program failed with ${translatedResult}: ${translatedError}")
endif()
foreach(output nativeOutput translatedOutput)
    string(REGEX REPLACE "time [^\n]*\n" "" ${output} "${${output}}")
endforeach()
if(translatedOutput MATCHES "mismatches=([0-9]+)" AND NOT CMAKE_MATCH_1 STREQUAL "0")
    message(FATAL_ERROR "Translated program observed ${CMAKE_MATCH_1} out-of-order publications")
endif()
string(REGEX REPLACE "mismatches=[0-9]+\n" "" nativeOutput "${nativeOutput}")
string(REGEX REPLACE "mismatches=[0-9]+\n" "" translatedOutput "${translatedOutput}")
if(NOT nativeOutput STREQUAL translatedOutput)
    message(FATAL_ERROR "Output differs.\nnative:\n${nativeOutput}\ntranslated:\n${translatedOutput}")
endif()
